# Cloudflare Worker secrets. Set through the hosting secret interface, never NEXT_PUBLIC_*.
OPENROUTER_API_KEY=
AI_IP_HMAC_KEY=

# Required canonical origin (HTTPS in production) and audited Azure model slug.
SITE_URL=
OPENROUTER_AZURE_MODEL=
# Optional exact dated canonical alias verified against the OpenRouter model catalog.
OPENROUTER_AZURE_CANONICAL_MODEL=
# Set json_object for Azure endpoints without strict structured_outputs support.
AI_PRIMARY_RESPONSE_MODE=json_schema
# Sol requires reasoning: low excludes internal reasoning. Server default is none for optional endpoints.
AI_PRIMARY_REASONING_EFFORT=low

# Enable only after Azure BYOK model/API-key filters and BYOK-only account routing are verified.
AI_ENABLED=false
AI_AZURE_BYOK_ONLY_CONFIRMED=false

# Authorized daily upper bounds: USD 20 and 200 jobs; no lifetime spending cap.
# Default primary caps cover the audited Azure GPT-6.1 Sol route; token maximum is 3500.
# Price settings must fit the configured conservative two-lane reservation.
AI_DAILY_CALL_LIMIT=200
AI_DAILY_BUDGET_USD=20
AI_JOB_RESERVE_USD=0.10
AI_MAX_OUTPUT_TOKENS=3200
AI_MAX_PROMPT_PRICE_PER_MILLION=2
AI_MAX_COMPLETION_PRICE_PER_MILLION=10

# DB is a provisioned Cloudflare D1 binding, not an environment string.

# Optional owner browser exception. Base64url SHA-256 of a random 32-byte device token.
# Provision via POST /api/owner/device; never put the token in URLs or source.
# Empty means disabled. Rotate/remove to revoke. Budget and concurrency remain enforced.
OWNER_DEVICE_TOKEN_HASH=
